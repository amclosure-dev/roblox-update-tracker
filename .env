TOKEN=token # put your bot token in here
CHANNEL_ID=channel # put the channel id of the channel where you want the bot to send notifications
PREMESSAGE=@update # Message sent above the embed
POLL_INTERVAL=60000
EMBED_COLOR=#00a2ff # the hex color you want the embed to be
PLATFORMS=windows,mac,ios,android # platfors to track, can be windows, mac, ios and android
STATUS=dnd # bot presence, can be online, idle, dnd or offline
ACTIVITY_TYPE=playing # what your bot will appear to be doing, can be playing, watching, listening or competing
ACTIVITY_NAME=Made by nymus # activity text shown in your status, can be anything you want or nothing
FUTURE=true # enable notifications when a future version of the build is detected
REVERTS=true # enable notifications when roblox is detected to be reverting to an older build